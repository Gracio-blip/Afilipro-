# ============================================================
# AFILIPRO — Variables d'environnement PRODUCTION
# Copiez ce fichier en .env.local sur votre hébergeur
# ============================================================

# Base de données PostgreSQL (Neon, Supabase, Railway, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/afilipro

# NextAuth — secret de chiffrement des sessions JWT
# Générer avec : openssl rand -base64 32
AUTH_SECRET=VOTRE_SECRET_ICI

# URL publique de votre site (sans slash final)
NEXT_PUBLIC_APP_URL=https://votre-domaine.com

# Telegram — notifications retraits et dépôts
TELEGRAM_BOT_TOKEN=8735161135:AAHt2w069NoMVcWFNttRuodjvHCnXar1MZY
TELEGRAM_CHAT_ID=8735161135
